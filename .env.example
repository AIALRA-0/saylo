# OpenAI 密钥只由本地服务器读取，浏览器无法访问这个值
OPENAI_API_KEY=

# GPT-5.6 Luna 负责低成本的文字教练反馈
OPENAI_MODEL=gpt-5.6-luna

# DeepSeek 可以独立承担文字语用评析，密钥仍只由服务器读取
DEEPSEEK_API_KEY=

# V4 Flash 默认用于高频短回合评析，可换为 deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash

# Realtime 2.1 负责可选的低延迟语音对练
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# 本地服务器端口
PORT=8787

# 本地默认仅允许当前设备访问，部署环境可以改为 0.0.0.0
HOST=127.0.0.1

# 生产环境填写浏览器实际访问的完整来源，本地开发可以留空
PUBLIC_ORIGIN=

# 可信身份代理接管访问控制后设为 true，本地开发保持 false
REQUIRE_PROXY_AUTH=false

# 生产环境填写权限为 0700 的个人模型配置目录，本地开发可以留空
SAYLO_PROVIDER_CONFIG_DIR=
