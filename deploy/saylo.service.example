# 把本文件复制到 systemd 配置目录前，先替换账户、目录和公开来源
[Unit]
Description=Saylo contemporary English training
After=network-online.target
Wants=network-online.target

[Service]
# 使用没有交互式登录权限的独立账户运行应用
Type=simple
User=saylo
Group=saylo
WorkingDirectory=/opt/saylo/current

# 应用只监听回环地址，公开流量统一经过反向代理
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=PUBLIC_ORIGIN=https://saylo.example.com
Environment=REQUIRE_PROXY_AUTH=false
Environment=SAYLO_PROVIDER_CONFIG_DIR=/var/lib/saylo/coach-providers
EnvironmentFile=-/etc/saylo/saylo.env

# 进程异常退出时自动恢复，同时限制能够修改的系统范围
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/saylo

[Install]
WantedBy=multi-user.target
