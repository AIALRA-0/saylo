# 示例域名需要替换为部署者控制的域名
server {
    listen 443 ssl http2;
    server_name saylo.example.com;

    # 证书路径需要匹配部署者使用的证书管理工具
    ssl_certificate /etc/ssl/saylo.example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/saylo.example.com/privkey.pem;

    # 浏览器只访问同源接口，反向代理负责把请求交给回环服务
    location / {
        # 清除公网客户端可能伪造的身份头
        proxy_set_header X-Authenticated "";
        proxy_set_header X-Auth-User "";
        proxy_set_header X-Auth-Role "";

        # 启用身份代理时，在这里加入认证子请求并写入可信身份值
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
